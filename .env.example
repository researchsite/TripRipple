# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Interactive features (Ask Memory, Inject Event, Constraint Editor)
# Set to false to run the linear 6-step demo without AI features
NEXT_PUBLIC_INTERACTIVE_FEATURES=true

# OpenRouter — enables AI answers in Ask Memory and Inject Event
# Get your key at https://openrouter.ai
OPENROUTER_API_KEY=

# Anthropic direct — fallback if no OpenRouter key
# ANTHROPIC_API_KEY=

# Elasticsearch Serverless
# Get endpoint + API key from https://cloud.elastic.co → your project → API keys
# After adding keys, run:  npm run reset:elastic
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Amadeus (decommissioned July 2026 — leave blank, app uses cached hotel data)
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# DEMO_USE_CACHE=true
